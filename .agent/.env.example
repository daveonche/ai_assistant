# ==============================================================================
# Environment Variables for Aider (AI Assistant)
# 
# IMPORTANT: Do not commit the actual .env file with real secrets.
# This is a template file. Copy it to .env and fill in your values.
# ==============================================================================

# --- OpenAI ---
OPENAI_API_KEY=sk-proj-...

# --- OpenRouter ---
OPENROUTER_API_KEY=sk-or-v1-...
AIDER_OPENROUTER_API_KEY=sk-or-v1-...

# --- Hugging Face ---
HF_TOKEN=hf_...
AIDER_HF_TOKEN=hf_...

# --- Google Gemini ---
GEMINI_API_KEY=AIzaSy...
AIDER_GEMINI_API_KEY=AIzaSy...

# --- Anthropic (Optional) ---
# ANTHROPIC_API_KEY=sk-ant-...
# AIDER_ANTHROPIC_API_KEY=sk-ant-...

# --- LiteLLM Settings ---
LITELLM_NUM_RETRIES=5
